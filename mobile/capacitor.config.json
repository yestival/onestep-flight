{
  "appId": "com.selene.onestepflight",
  "appName": "OneStep Flight",
  "webDir": "www",
  "server": {
    "iosScheme": "capacitor",
    "androidScheme": "https",
    "hostname": "localhost"
  },
  "ios": {
    "contentInset": "never",
    "scrollEnabled": true,
    "zoomEnabled": true,
    "backgroundColor": "#F3F4F7"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "style": "LIGHT"
    },
    "CapacitorHttp": {
      "enabled": false
    }
  }
}
